# Шаблон боевого окружения. Настоящий .env.prod живёт только на сервере,
# в git его нет. Скопировать, заполнить, положить рядом с docker-compose.prod.yml.

# --- База данных -------------------------------------------------------------
POSTGRES_DB=traff
POSTGRES_USER=traff
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Веб ---------------------------------------------------------------------
# Порт наружу. На сервере 80/443 занял общий Traefik, поэтому берём свободный.
APP_PORT=8094
# openssl rand -base64 48
SECRET_KEY=
# Адрес, от которого строятся трекинг-ссылки в статьях. Пока нет домена — IP с портом.
# ВАЖНО: с http-адресом лучше держать в проекте выключенным счётчик кликов, иначе в
# опубликованной статье будет незащищённая ссылка на голый IP.
PUBLIC_BASE_URL=http://SERVER_IP:8094

# --- Генерация статей --------------------------------------------------------
# Ключ routerai.ru (тот же кабинет, что у соседних проектов)
ROUTER_API_KEY=
ROUTER_BASE_URL=https://routerai.ru/api/v1
ROUTER_MODEL=qwen/qwen-plus
ROUTER_MODEL_SHORT=qwen/qwen-plus
LLM_MAX_TOKENS=8000

# --- Трекинг подписок --------------------------------------------------------
# Бот должен быть администратором канала с правом приглашать.
# Пока пусто — статьи получают прямые ссылки, атрибуции подписок нет.
TELEGRAM_BOT_TOKEN=
TGTRACK_TG_API_KEY=
TGTRACK_MAX_API_KEY=

# --- Напоминания -------------------------------------------------------------
# Куда слать «пора обновить статистику». Пусто — только в интерфейсе и журнале.
NOTIFY_CHAT_ID=
METRICS_STALE_DAYS=8

# --- Первый пользователь -----------------------------------------------------
# Создаётся один раз командой:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm web python -m app.cli bootstrap
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
