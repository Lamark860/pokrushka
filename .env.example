# --- База данных -------------------------------------------------------------
# Локально через docker-compose поднимается postgres на 5436
DATABASE_URL=postgresql+psycopg://traff:traff@localhost:5436/traff

# --- Веб ---------------------------------------------------------------------
# Ключ подписи сессионной куки. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please
# Публичный адрес сервиса — от него строятся трекинг-ссылки /r/<code> (этап 2)
PUBLIC_BASE_URL=http://localhost:8099

# --- Генерация статей --------------------------------------------------------
# Основной путь — OpenAI-совместимый прокси routerai.ru (как в ceramic и Vlad:
# там team-ключ с контролем бюджета). Имя модели сверьте с каталогом routerai.ru;
# для статей имеет смысл модель посильнее, чем haiku.
ROUTER_API_KEY=
ROUTER_BASE_URL=https://routerai.ru/api/v1
# Модель выбрана сравнением 21 модели каталога на живой задаче: важнее всего, чтобы
# текст укладывался в лимит площадки. Замены, показавшие себя близко:
# openai/gpt-4.1-mini (чуть выше качество, иногда переспам ключей),
# openai/gpt-5-mini (иногда ломает формат ответа).
ROUTER_MODEL=qwen/qwen-plus
# Посты в Telegram и MAX
ROUTER_MODEL_SHORT=qwen/qwen-plus

# Запасной путь — прямой ключ провайдера. Используется, только если ROUTER_API_KEY пуст.
# Без обоих ключей генератор работает на шаблоне-фолбэке (демо без интернета).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=8000
# low | medium | high | xhigh | max
LLM_EFFORT=high

# --- Трекинг подписок (этап 2) ------------------------------------------------
# Бот должен быть админом канала с правом приглашать: только тогда приходят события
# вступления (chat_member) и можно создавать именованные пригласительные ссылки.
# Пусто — статьи получают прямые ссылки на канал, атрибуции подписок нет.
TELEGRAM_BOT_TOKEN=
# Ключи сервиса «Откуда подписки» (tgtrack.ru): добор UTM по подписчикам
TGTRACK_TG_API_KEY=
TGTRACK_MAX_API_KEY=

# --- Напоминания планировщика (этап 3) ----------------------------------------
# Куда слать «пора обновить статистику»: личка Артура или служебный чат.
# Пусто — напоминание останется в интерфейсе и журнале задач.
NOTIFY_CHAT_ID=
# Через сколько дней без срезов статистика считается устаревшей
METRICS_STALE_DAYS=8

# --- Первый пользователь (создаётся командой `python3 -m app.cli bootstrap`) ---
BOOTSTRAP_EMAIL=artur@example.com
BOOTSTRAP_PASSWORD=
